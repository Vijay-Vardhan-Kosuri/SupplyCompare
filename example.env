# SupplyCompare Environment Template
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file with production secrets.

DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL)
DB_ENGINE=mysql
DB_NAME=supplycompare_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Authentication & Tokens
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
